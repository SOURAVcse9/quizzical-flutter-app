# ==========================================
# Flutter & Dart Production Gitignore
# ==========================================

# Flutter/Dart Build & Tooling
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
/build/
**/build/
/coverage/
**/doc/api/
.widget_preview/
**/ios/Flutter/.last_build_id

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# ==========================================
# Android
# ==========================================
.gradle/
android/.gradle/
**/android/.gradle/
captures/
.externalNativeBuild/
android/local.properties
/android/app/debug
/android/app/profile
/android/app/release
**/android/app/release/
*.apk
*.aab
*.keystore
*.jks

# ==========================================
# iOS & macOS
# ==========================================
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.flx
**/ios/Flutter/flutter_assets/
**/ios/ServiceDefinitions.json
DerivedData/
*.mode1v3
*.mode2v3
*.moved-aside
*.pbxuser
*.perspectivev3
xcuserdata/

# ==========================================
# Desktop Platforms (Windows / Linux / macOS)
# ==========================================
**/windows/flutter/ephemeral/
**/linux/flutter/ephemeral/
**/macos/Flutter/ephemeral/

# ==========================================
# IDEs & Editors
# ==========================================
# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Eclipse
.metadata/
.classpath
.project
.settings/

# ==========================================
